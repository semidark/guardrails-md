{
  "name": "guardrails-md",
  "version": "0.8.0",
  "description": "GUARDRAILS.md gate for opencode, pi and Claude Code (hooks module): a self-hosted System One decision model judges every bash command before it runs — destructive / credentials / GUARDRAILS.md policy. No vendor defaults: all traffic goes to your own endpoint.",
  "type": "module",
  "exports": {
    ".": "./adapters/opencode.ts",
    "./opencode": "./adapters/opencode.ts",
    "./server": "./adapters/opencode.ts",
    "./pi": "./adapters/pi.ts"
  },
  "files": [
    "core.ts",
    "plugin/index.ts",
    "adapters/opencode.ts",
    "adapters/pi.ts",
    ".claude-plugin/plugin.json",
    "hooks/hooks.json",
    "hooks/pre-commit",
    "hooks/register.ts",
    "README.md",
    "guardrails.example.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:claude": "scripts/test-claude.sh"
  },
  "pi": {
    "extensions": [
      "./adapters/pi.ts"
    ]
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pi",
    "pi-package",
    "systemone",
    "safety",
    "guardrails",
    "bash",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semidark/guardrails-md.git"
  },
  "bugs": {
    "url": "https://github.com/semidark/guardrails-md/issues"
  },
  "homepage": "https://github.com/semidark/guardrails-md#readme",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
